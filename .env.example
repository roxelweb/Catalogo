# URL pública del sitio en producción (sin barra final).
# Activa las etiquetas canonical, og:url, sitemap.xml y el enlace Sitemap en robots.txt.
SITE_URL=https://tu-dominio.com.ar

# Token opcional de verificación para Google Search Console (solo el valor del atributo content).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Credenciales de Contentful Delivery API
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
