---
import { Footer, StoreHeader } from "@/components";
import { loadStoreData } from "@/data";
import Layout from "@layouts/Layout.astro";

const store = await loadStoreData();
const rootNavItems = store.navItems.map((item) => ({
  ...item,
  href: item.href.startsWith("#") ? `/${item.href}` : item.href,
}));
---

<Layout
  title="Página no encontrada | Roxel Essence"
  description="La página que buscás no existe en Roxel Essence. Volvé al catálogo de perfumes."
  noindex={true}
>
  <StoreHeader
    client:load
    deliveryOptions={store.deliveryOptions}
    meetingPoints={store.meetingPoints}
    whatsappPhone={store.contact.whatsappPhone}
    navItems={rootNavItems}
  />
  <main
    id="contenido-principal"
    class="bg-roxel-surface px-4 sm:px-6 lg:px-8 py-24 sm:py-32"
  >
    <div
      class="mx-auto max-w-xl rounded-xl border border-roxel-border-subtle bg-roxel-surface-card p-8 sm:p-10 text-center shadow-card roxel-card"
    >
      <p class="text-xs sm:text-sm font-bold uppercase tracking-widest text-roxel-ink-muted">
        Error 404
      </p>
      <h1 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-roxel-ink">
        No encontramos esta página
      </h1>
      <p class="mt-3 text-sm sm:text-base leading-relaxed text-roxel-ink-muted">
        El enlace que seguiste puede haber cambiado o no estar disponible.
        Volvé al catálogo para explorar nuestros decants, perfumes árabes,
        testers y extractos.
      </p>
      <div class="mt-7 flex justify-center">
        <a
          href="/"
          class="roxel-control inline-flex items-center justify-center min-h-11 px-6 py-2.5 rounded-full bg-roxel-gold-400 hover:bg-roxel-dark-900 hover:text-roxel-gold-400 active:bg-roxel-dark-800 active:text-roxel-gold-400 text-roxel-ink text-sm sm:text-base font-semibold transition-colors touch-manipulation focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-roxel-ink"
        >
          Volver al catálogo
        </a>
      </div>
    </div>
  </main>
  <Footer
    id="contacto"
    schedule={store.contact.schedule}
    phoneDisplay={store.contact.phoneDisplay}
    phoneHref={store.contact.whatsappUrl}
    socialLinks={store.contact.socialLinks}
  />
</Layout>
