---
import { CatalogSection, Footer, Hero, StoreHeader } from "@/components";
import { CATALOG_CATEGORIES, DELIVERY_METHOD_OPTIONS } from "@/data";
import Layout from "@layouts/Layout.astro";
---

<Layout title="Roxel Essence | Catálogo de Perfumes">
  <StoreHeader client:load deliveryOptions={DELIVERY_METHOD_OPTIONS} />
  <Hero />
  <main id="contenido-principal" class="bg-roxel-surface overflow-x-clip">
    <CatalogSection client:load categories={CATALOG_CATEGORIES} />
  </main>
  <Footer id="contacto" />
</Layout>
