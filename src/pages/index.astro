---
import { CatalogSection, Footer, StoreHeader } from "@/components";
import {
  buildStoreStructuredData,
  extractExternalImageOrigins,
  loadStoreData,
  SITE_CONFIG,
} from "@/data";
import Hero from "@components/layout/Hero.astro";
import Layout from "@layouts/Layout.astro";

const store = await loadStoreData();

const jsonLd = buildStoreStructuredData({
  site: Astro.site,
  pageTitle: SITE_CONFIG.defaultTitle,
  pageDescription: SITE_CONFIG.defaultDescription,
  categories: store.categories,
  phoneDisplay: store.contact.phoneDisplay,
  whatsappUrl: store.contact.whatsappUrl,
  socialLinks: store.contact.socialLinks,
});

const dnsPrefetchOrigins = extractExternalImageOrigins(store.categories);
---

<Layout
  title={SITE_CONFIG.defaultTitle}
  description={SITE_CONFIG.defaultDescription}
  jsonLd={jsonLd}
  dnsPrefetchOrigins={dnsPrefetchOrigins}
>
  <StoreHeader
    client:load
    deliveryOptions={store.deliveryOptions}
    meetingPoints={store.meetingPoints}
    whatsappPhone={store.contact.whatsappPhone}
    navItems={store.navItems}
  />
  <Hero description={store.heroDescription} />
  <main id="contenido-principal" class="bg-roxel-surface overflow-x-clip">
    <CatalogSection
      client:visible={{ rootMargin: "200px" }}
      categories={store.categories}
      whatsappPhone={store.contact.whatsappPhone}
    />
  </main>
  <Footer
    id="contacto"
    schedule={store.contact.schedule}
    phoneDisplay={store.contact.phoneDisplay}
    phoneHref={store.contact.whatsappUrl}
    socialLinks={store.contact.socialLinks}
  />
</Layout>
